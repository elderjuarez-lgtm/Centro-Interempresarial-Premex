# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Configuración opcional para conectar a tu propio proyecto de Firebase existente
# Copia este archivo como ".env" y pega las credenciales de tu Firebase Console.
# Si se dejan vacíos, la app usará automáticamente "firebase-applet-config.json".
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Opcional: deja vacío si tu proyecto usa la base "(default)" de Firestore
VITE_FIREBASE_DATABASE_ID=""

# -----------------------------------------------------------------------------
# Conector Servidor -> API REST Odoo (JSON · Módulo de Gastos / hr.expense)
# Variables EXCLUSIVAMENTE del servidor (nunca usar prefijo VITE_ ni exponer en el navegador)
# -----------------------------------------------------------------------------
ODOO_API_PROTOCOL="rest"
# URL completa del endpoint REST JSON (ej. https://tu-servidor/api/odoo/expenses)
ODOO_REST_URL=""
# Alternativa si se usa URL base de Odoo:
ODOO_URL=""
# Token o API Key para la API REST (enviado en cabecera Authorization: Bearer ... o personalizada)
ODOO_API_KEY=""
# Opcional: personalizar cabecera y modo REST ("Authorization" con "Bearer", o "X-API-Key" sin prefijo)
ODOO_AUTH_HEADER="Authorization"
ODOO_AUTH_PREFIX="Bearer"
ODOO_REST_BATCH_MODE="batch"
# Opcional: "true" para agrupar cada liquidación en un Informe de Gastos (hr.expense.sheet)
ODOO_CREATE_EXPENSE_SHEET="false"
# Solo requeridos si ODOO_API_PROTOCOL="jsonrpc":
ODOO_DB=""
ODOO_USERNAME=""

