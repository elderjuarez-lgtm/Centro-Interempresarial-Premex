# Puerto local del Agente Puente (solo escucha en 127.0.0.1)
PORT=4780

# Origen web autorizado (URL donde despliegas Premex Suite o http://localhost:3000 en dev)
ALLOWED_ORIGINS=http://localhost:3000,https://tu-app-premex.vercel.app

# Token Bearer compartido entre este agente y tu sesión en la app web (cámbialo por uno largo)
AGENT_TOKEN=cambia-este-token-secreto-premex-2026

# URLs corporativas objetivo
CLARA_URL=https://colombia.clara.com/auth/login
WM_URL=https://pan.iluma.bio:8037/Account/Login

# Opcional: si Work Manager (:8037) usa certificado interno autofirmado en intranet/VPN
WM_IGNORE_HTTPS_ERRORS=true

# Opcional: carpeta de salida donde el bot independiente de SAP lee el paquete
SAP_DISPATCH_DIR=./sap-queue
