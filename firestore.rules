rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        'email' in request.auth.token &&
        request.auth.token.email is string;
    }

    function myEmailLower() {
      return request.auth.token.email.lower();
    }

    function emailToDocId(email) {
      return email.lower().replace('[^a-z0-9]', '_');
    }

    function myEmailDocId() {
      return emailToDocId(request.auth.token.email);
    }

    // Bootstrapped Super Admin (strictly requires email_verified == true)
    function isSuperAdmin() {
      return isVerifiedUser() && myEmailLower() == 'elder.juarez@premexcorp.com';
    }

    function hasMyPermissionDoc() {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/user_permissions/$(myEmailDocId()));
    }

    function myPermissionData() {
      return get(/databases/$(database)/documents/user_permissions/$(myEmailDocId())).data;
    }

    function isAdmin() {
      return isSuperAdmin() || (
        hasMyPermissionDoc() &&
        myPermissionData().active == true &&
        myPermissionData().role == 'admin'
      );
    }

    // First-time bootstrap gate: allows an authenticated verified deployer to initialize
    // the permissions registry ONCE before /app_settings/access_control exists.
    // Closes automatically and permanently as soon as access_control is published.
    function isBootstrapAdmin() {
      return isVerifiedUser() &&
        !exists(/databases/$(database)/documents/app_settings/access_control);
    }

    // Fail-closed strict mode: enabled by default until an administrator explicitly sets strictMode == false
    function isStrictModeEnabled() {
      return !exists(/databases/$(database)/documents/app_settings/policy) ||
        get(/databases/$(database)/documents/app_settings/policy).data.strictMode == true;
    }

    // Verified users authorized to read a specific operational module
    function canReadModule(moduleId) {
      return isAdmin() || (
        isVerifiedUser() && (
          (!hasMyPermissionDoc() && !isStrictModeEnabled()) || (
            hasMyPermissionDoc() &&
            myPermissionData().active == true &&
            moduleId in myPermissionData().allowedModules
          )
        )
      );
    }

    // Only verified Admins or explicitly registered active Operadores for the target module can write operational data.
    // Unregistered users, 'consulta' (read-only) users, and inactive users are strictly denied writes.
    function canOperateModule(moduleId) {
      return isAdmin() || (
        hasMyPermissionDoc() &&
        myPermissionData().active == true &&
        myPermissionData().role == 'operador' &&
        moduleId in myPermissionData().allowedModules
      );
    }

    // Verified users permitted to manage non-PII corporate catalogs in module_company_directories:
    // Admins, first-time bootstrapper, active module operators, or verified non-strict users without a restrictive role doc.
    function canManageModuleCatalog(moduleId) {
      return isAdmin() ||
        isBootstrapAdmin() ||
        canOperateModule(moduleId) || (
          isVerifiedUser() &&
          !isStrictModeEnabled() &&
          !hasMyPermissionDoc()
        );
    }

    // Verified users permitted to read non-PII module company catalogs (admin, active registered user,
    // or non-strict mode verified user)
    function canReadCompanyCatalogs() {
      return isAdmin() || (
        isVerifiedUser() && (
          (!hasMyPermissionDoc() && !isStrictModeEnabled()) || (
            hasMyPermissionDoc() &&
            myPermissionData().active == true
          )
        )
      );
    }

    function isValidReconciliation(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'selectedMonth',
          'entities',
          'movements',
          'comments',
          'movementsCount',
          'entitiesCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'ownerName',
          'title',
          'selectedMonth',
          'entities',
          'movements',
          'comments',
          'closedMonths',
          'movementsCount',
          'entitiesCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 120)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.selectedMonth is string && data.selectedMonth.size() >= 1 && data.selectedMonth.size() <= 60 &&
        data.entities is list && data.entities.size() <= 200 &&
        (data.entities.size() == 0 || data.entities[0] is map) &&
        data.movements is list && data.movements.size() <= 5000 &&
        (data.movements.size() == 0 || data.movements[0] is map) &&
        data.comments is map && data.comments.size() <= 2000 &&
        (!('closedMonths' in data) || (data.closedMonths is map && data.closedMonths.size() <= 120)) &&
        data.movementsCount is int && data.movementsCount >= 0 && data.movementsCount <= 5000 &&
        data.entitiesCount is int && data.entitiesCount >= 0 && data.entitiesCount <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidActivityWorkspace(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'selectedPeriod',
          'societies',
          'responsibles',
          'activities',
          'executions',
          'notificationRecipients',
          'notifyAdminsAutomatically',
          'subtleReminderDaysBefore',
          'societiesCount',
          'activitiesCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'ownerName',
          'title',
          'selectedPeriod',
          'societies',
          'responsibles',
          'activities',
          'executions',
          'notificationRecipients',
          'notifyAdminsAutomatically',
          'subtleReminderDaysBefore',
          'societiesCount',
          'activitiesCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 120)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.selectedPeriod is string && data.selectedPeriod.size() >= 4 && data.selectedPeriod.size() <= 20 &&
        data.societies is list && data.societies.size() <= 100 &&
        (data.societies.size() == 0 || data.societies[0] is map) &&
        data.responsibles is list && data.responsibles.size() <= 200 &&
        (data.responsibles.size() == 0 || data.responsibles[0] is map) &&
        data.activities is list && data.activities.size() <= 200 &&
        (data.activities.size() == 0 || data.activities[0] is map) &&
        data.executions is map && data.executions.size() <= 3000 &&
        data.notificationRecipients is list && data.notificationRecipients.size() <= 100 &&
        (data.notificationRecipients.size() == 0 || data.notificationRecipients[0] is map) &&
        data.notifyAdminsAutomatically is bool &&
        data.subtleReminderDaysBefore is int && data.subtleReminderDaysBefore >= 0 && data.subtleReminderDaysBefore <= 30 &&
        data.societiesCount is int && data.societiesCount >= 0 && data.societiesCount <= 100 &&
        data.activitiesCount is int && data.activitiesCount >= 0 && data.activitiesCount <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClosedPeriod(data) {
      return data.keys().hasAll([
          'ownerId',
          'reconciliationId',
          'month',
          'title',
          'entities',
          'movements',
          'comments',
          'movementsCount',
          'entitiesCount',
          'differencesCount',
          'closedAtIso',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'ownerName',
          'reconciliationId',
          'month',
          'title',
          'entities',
          'movements',
          'comments',
          'movementsCount',
          'entitiesCount',
          'differencesCount',
          'closedAtIso',
          'createdAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 120)) &&
        data.reconciliationId is string && isValidId(data.reconciliationId) &&
        data.month is string && data.month.size() >= 1 && data.month.size() <= 60 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.entities is list && data.entities.size() <= 200 &&
        (data.entities.size() == 0 || data.entities[0] is map) &&
        data.movements is list && data.movements.size() <= 5000 &&
        (data.movements.size() == 0 || data.movements[0] is map) &&
        data.comments is map && data.comments.size() <= 2000 &&
        data.movementsCount is int && data.movementsCount >= 0 && data.movementsCount <= 5000 &&
        data.entitiesCount is int && data.entitiesCount >= 0 && data.entitiesCount <= 200 &&
        data.differencesCount is int && data.differencesCount >= 0 && data.differencesCount <= 5000 &&
        data.closedAtIso is string && data.closedAtIso.size() >= 1 && data.closedAtIso.size() <= 60 &&
        data.createdAt is timestamp;
    }

    function isValidCompanyDirectory(data) {
      return data.keys().hasAll([
          'scope',
          'entities',
          'entitiesCount',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'scope',
          'entities',
          'entitiesCount',
          'updatedBy',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.scope is string && data.scope in ['internacionales', 'nacionales', 'anitox'] &&
        data.entities is list && data.entities.size() <= 200 &&
        (data.entities.size() == 0 || data.entities[0] is map) &&
        data.entitiesCount is int && data.entitiesCount >= 0 && data.entitiesCount <= 200 &&
        data.updatedBy is string && isValidId(data.updatedBy) &&
        (!('updatedByName' in data) || (data.updatedByName is string && data.updatedByName.size() <= 120)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidModuleCompanyDirectory(data) {
      return data.keys().hasAll([
          'moduleId',
          'companies',
          'companiesCount',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'moduleId',
          'companies',
          'companiesCount',
          'updatedBy',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.moduleId is string && data.moduleId in ['bancos', 'viaticos', 'actividades', 'clara', 'anticipos', 'cxc', 'cxp'] &&
        data.companies is list && data.companies.size() <= 300 &&
        (data.companies.size() == 0 || data.companies[0] is map) &&
        data.companiesCount is int && data.companiesCount >= 0 && data.companiesCount <= 300 &&
        data.companiesCount == data.companies.size() &&
        data.updatedBy is string && isValidId(data.updatedBy) &&
        (!('updatedByName' in data) || (data.updatedByName is string && data.updatedByName.size() <= 120)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBankReconciliation(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'selectedMonth',
          'accounts',
          'statementItems',
          'ledgerItems',
          'matches',
          'accountsCount',
          'statementCount',
          'ledgerCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'ownerName',
          'title',
          'selectedMonth',
          'selectedAccountId',
          'openPeriod',
          'closedReconciliations',
          'societies',
          'accounts',
          'sapOpenItems',
          'sapBalanceRows',
          'statementItems',
          'ledgerItems',
          'matches',
          'accountsCount',
          'statementCount',
          'ledgerCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 120)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.selectedMonth is string && data.selectedMonth.size() >= 1 && data.selectedMonth.size() <= 60 &&
        (!('selectedAccountId' in data) || (data.selectedAccountId is string && data.selectedAccountId.size() <= 128)) &&
        (!('openPeriod' in data) || (data.openPeriod is string && data.openPeriod.size() <= 60)) &&
        (!('closedReconciliations' in data) || (data.closedReconciliations is list && data.closedReconciliations.size() <= 60 && (data.closedReconciliations.size() == 0 || data.closedReconciliations[0] is map))) &&
        (!('societies' in data) || (data.societies is list && data.societies.size() <= 100 && (data.societies.size() == 0 || data.societies[0] is map))) &&
        data.accounts is list && data.accounts.size() <= 300 &&
        (data.accounts.size() == 0 || data.accounts[0] is map) &&
        (!('sapOpenItems' in data) || (data.sapOpenItems is list && data.sapOpenItems.size() <= 5000 && (data.sapOpenItems.size() == 0 || data.sapOpenItems[0] is map))) &&
        (!('sapBalanceRows' in data) || (data.sapBalanceRows is list && data.sapBalanceRows.size() <= 5000 && (data.sapBalanceRows.size() == 0 || data.sapBalanceRows[0] is map))) &&
        data.statementItems is list && data.statementItems.size() <= 5000 &&
        (data.statementItems.size() == 0 || data.statementItems[0] is map) &&
        data.ledgerItems is list && data.ledgerItems.size() <= 5000 &&
        (data.ledgerItems.size() == 0 || data.ledgerItems[0] is map) &&
        data.matches is list && data.matches.size() <= 5000 &&
        (data.matches.size() == 0 || data.matches[0] is map) &&
        data.accountsCount is int && data.accountsCount >= 0 && data.accountsCount <= 300 &&
        data.statementCount is int && data.statementCount >= 0 && data.statementCount <= 5000 &&
        data.ledgerCount is int && data.ledgerCount >= 0 && data.ledgerCount <= 5000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPermission(data) {
      return data.keys().hasAll([
          'email',
          'displayName',
          'role',
          'allowedModules',
          'companyScope',
          'allowedCompanies',
          'active',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'email',
          'displayName',
          'role',
          'userType',
          'allowedModules',
          'viaticosPanels',
          'companyScope',
          'allowedCompanies',
          'moduleCompanyAccess',
          'active',
          'notes',
          'odooEmployeeName',
          'assignedEmployees',
          'centroCosto',
          'odooAnalyticDistribution',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role is string && data.role in ['admin', 'operador', 'consulta'] &&
        (!('userType' in data) || (data.userType is string && data.userType in ['administrador', 'liquidador', 'contabilidad', 'autorizador', 'auditor', 'personalizado'])) &&
        data.allowedModules is list && data.allowedModules.size() <= 10 &&
        data.allowedModules.hasOnly(['intercompany', 'bancos', 'viaticos', 'actividades', 'clara', 'anticipos', 'cxc', 'cxp', 'ajustes']) &&
        (!('viaticosPanels' in data) || (
          data.viaticosPanels is list &&
          data.viaticosPanels.size() <= 10 &&
          data.viaticosPanels.hasOnly(['liquidador', 'sociedades', 'cerradas', 'contabilidad', 'historial', 'correos'])
        )) &&
        data.companyScope is string && data.companyScope in ['all', 'selected'] &&
        data.allowedCompanies is list && data.allowedCompanies.size() <= 300 &&
        (data.allowedCompanies.size() == 0 || data.allowedCompanies[0] is string) &&
        (!('moduleCompanyAccess' in data) || (
          data.moduleCompanyAccess is map &&
          data.moduleCompanyAccess.size() <= 10 &&
          data.moduleCompanyAccess.keys().hasOnly(['intercompany', 'bancos', 'viaticos', 'actividades', 'clara', 'anticipos', 'cxc', 'cxp'])
        )) &&
        data.active is bool &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
        (!('odooEmployeeName' in data) || (data.odooEmployeeName is string && data.odooEmployeeName.size() <= 140)) &&
        (!('assignedEmployees' in data) || (
          data.assignedEmployees is list &&
          data.assignedEmployees.size() <= 100 &&
          (data.assignedEmployees.size() == 0 || data.assignedEmployees[0] is string)
        )) &&
        (!('centroCosto' in data) || (data.centroCosto is string && data.centroCosto.size() <= 140)) &&
        (!('odooAnalyticDistribution' in data) || (data.odooAnalyticDistribution is string && data.odooAnalyticDistribution.size() <= 120)) &&
        data.updatedBy is string && isValidId(data.updatedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAccessControlRegistry(data) {
      return data.keys().hasAll([
          'records',
          'recordsCount',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'records',
          'recordsCount',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.records is list && data.records.size() <= 200 &&
        (data.records.size() == 0 || data.records[0] is map) &&
        data.recordsCount is int && data.recordsCount >= 0 && data.recordsCount <= 200 &&
        data.updatedBy is string && isValidId(data.updatedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAccessPolicy(data) {
      return data.keys().hasAll([
          'strictMode',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'strictMode',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.strictMode is bool &&
        data.updatedBy is string && isValidId(data.updatedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidViaticosWorkspace(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'consultores',
          'liquidaciones',
          'consultoresCount',
          'liquidacionesCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'ownerName',
          'title',
          'activeLiquidationId',
          'consultores',
          'liquidaciones',
          'emailGroups',
          'odooCatalogs',
          'consultoresCount',
          'liquidacionesCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 120)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        (!('activeLiquidationId' in data) || (data.activeLiquidationId is string && data.activeLiquidationId.size() <= 128)) &&
        data.consultores is list && data.consultores.size() <= 200 &&
        (data.consultores.size() == 0 || data.consultores[0] is map) &&
        data.liquidaciones is list && data.liquidaciones.size() <= 500 &&
        (data.liquidaciones.size() == 0 || data.liquidaciones[0] is map) &&
        (!('emailGroups' in data) || (
          data.emailGroups is list &&
          data.emailGroups.size() <= 100 &&
          (data.emailGroups.size() == 0 || data.emailGroups[0] is map)
        )) &&
        (!('odooCatalogs' in data) || (
          data.odooCatalogs is map &&
          data.odooCatalogs.size() <= 16
        )) &&
        data.consultoresCount is int && data.consultoresCount >= 0 && data.consultoresCount <= 200 &&
        data.liquidacionesCount is int && data.liquidacionesCount >= 0 && data.liquidacionesCount <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidViaticosReceipt(data) {
      return data.keys().hasAll([
          'id',
          'parentReceiptId',
          'chunkIndex',
          'chunkCount',
          'workspaceId',
          'ownerId',
          'fileName',
          'mimeType',
          'size',
          'dataUrl',
          'createdAtIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'parentReceiptId',
          'chunkIndex',
          'chunkCount',
          'workspaceId',
          'ownerId',
          'ownerName',
          'fileName',
          'mimeType',
          'size',
          'dataUrl',
          'createdAtIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.parentReceiptId is string && isValidId(data.parentReceiptId) &&
        data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex <= 20 &&
        data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 20 &&
        data.chunkIndex < data.chunkCount &&
        data.workspaceId is string && isValidId(data.workspaceId) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 120)) &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
        data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 80 &&
        data.size is int && data.size >= 0 && data.size <= 20000000 &&
        data.dataUrl is string && data.dataUrl.size() >= 1 && data.dataUrl.size() <= 800000 &&
        data.createdAtIso is string && data.createdAtIso.size() >= 1 && data.createdAtIso.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClaraWorkspace(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'selectedPeriod',
          'transactions',
          'workManagerInvoices',
          'vendors',
          'costCenterRules',
          'connectorConfig',
          'batchLogs',
          'transactionsCount',
          'invoicesCount',
          'vendorsCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'ownerName',
          'title',
          'selectedPeriod',
          'transactions',
          'workManagerInvoices',
          'vendors',
          'costCenterRules',
          'connectorConfig',
          'batchLogs',
          'transactionsCount',
          'invoicesCount',
          'vendorsCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 120)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.selectedPeriod is string && data.selectedPeriod.size() >= 2 && data.selectedPeriod.size() <= 20 &&
        data.transactions is list && data.transactions.size() <= 2500 &&
        (data.transactions.size() == 0 || data.transactions[0] is map) &&
        data.workManagerInvoices is list && data.workManagerInvoices.size() <= 2500 &&
        (data.workManagerInvoices.size() == 0 || data.workManagerInvoices[0] is map) &&
        data.vendors is list && data.vendors.size() <= 1000 &&
        (data.vendors.size() == 0 || data.vendors[0] is map) &&
        data.costCenterRules is list && data.costCenterRules.size() <= 500 &&
        (data.costCenterRules.size() == 0 || data.costCenterRules[0] is map) &&
        data.connectorConfig is map && data.connectorConfig.size() <= 30 &&
        data.batchLogs is list && data.batchLogs.size() <= 200 &&
        (data.batchLogs.size() == 0 || data.batchLogs[0] is map) &&
        data.transactionsCount is int && data.transactionsCount >= 0 && data.transactionsCount <= 2500 &&
        data.invoicesCount is int && data.invoicesCount >= 0 && data.invoicesCount <= 2500 &&
        data.vendorsCount is int && data.vendorsCount >= 0 && data.vendorsCount <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /reconciliations/{reconciliationId} {
      // Strictly requires verified Google sign-in and authorization for the Intercompany module
      allow get: if isVerifiedUser() &&
        isValidId(reconciliationId) &&
        canReadModule('intercompany');

      // Verified users can only list their own reconciliations
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;

      // Verified admins or active intercompany operators can create reconciliations owned by themselves
      allow create: if isVerifiedUser() &&
        isValidId(reconciliationId) &&
        isValidReconciliation(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canOperateModule('intercompany');

      // Verified admins or authorized intercompany operators can collaboratively update shared reconciliations
      allow update: if isVerifiedUser() &&
        isValidId(reconciliationId) &&
        isValidReconciliation(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (!('closedMonths' in existing()) ||
          ('closedMonths' in incoming() && incoming().closedMonths.keys().hasAll(existing().closedMonths.keys()))) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerName',
          'title',
          'selectedMonth',
          'entities',
          'movements',
          'comments',
          'closedMonths',
          'movementsCount',
          'entitiesCount',
          'updatedAt'
        ]) &&
        (isAdmin() || canOperateModule('intercompany'));

      // Only verified owners (who are admins/operators) or admins can delete if no closed months exist
      allow delete: if isVerifiedUser() &&
        isValidId(reconciliationId) &&
        (!('closedMonths' in existing()) || existing().closedMonths.size() == 0) &&
        (isAdmin() || (existing().ownerId == request.auth.uid && canOperateModule('intercompany')));
    }

    match /closed_periods/{archiveId} {
      // Strictly requires verified Google sign-in and authorization for Intercompany
      allow get: if isVerifiedUser() &&
        isValidId(archiveId) &&
        canReadModule('intercompany');

      // Verified users can list only their own closed period archives
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;

      // Only verified administrators can permanently close a month
      allow create: if isVerifiedUser() &&
        isValidId(archiveId) &&
        isValidClosedPeriod(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin() &&
        exists(/databases/$(database)/documents/reconciliations/$(incoming().reconciliationId));

      // Permanent immutability: closed period archives can never be updated or deleted
      allow update, delete: if false;
    }

    match /company_directories/{scopeId} {
      // Requires verified Google sign-in and authorized catalog access
      allow get: if isVerifiedUser() &&
        isValidId(scopeId) &&
        scopeId in ['internacionales', 'nacionales', 'anitox'] &&
        canReadCompanyCatalogs();

      // List is not needed since directories are fetched directly by scopeId
      allow list: if false;

      // Admins, first-time bootstrapper, or authorized intercompany operators can create or update the independent directory
      allow create: if isVerifiedUser() &&
        isValidId(scopeId) &&
        scopeId in ['internacionales', 'nacionales', 'anitox'] &&
        isValidCompanyDirectory(incoming()) &&
        incoming().scope == scopeId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (canOperateModule('intercompany') || isBootstrapAdmin());

      allow update: if isVerifiedUser() &&
        isValidId(scopeId) &&
        scopeId in ['internacionales', 'nacionales', 'anitox'] &&
        isValidCompanyDirectory(incoming()) &&
        incoming().scope == existing().scope &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'entities',
          'entitiesCount',
          'updatedBy',
          'updatedByName',
          'updatedAt'
        ]) &&
        (canOperateModule('intercompany') || isBootstrapAdmin());

      allow delete: if false;
    }

    match /module_company_directories/{moduleId} {
      // Independent per-module company catalogs (contains no personal PII); readable by verified authorized users
      allow get: if isVerifiedUser() &&
        isValidId(moduleId) &&
        moduleId in ['bancos', 'viaticos', 'actividades', 'clara', 'anticipos', 'cxc', 'cxp'] &&
        canReadCompanyCatalogs();

      allow list: if false;

      // Managed by verified Administrators, first-time bootstrapper, or authorized module operators
      allow create: if isVerifiedUser() &&
        isValidId(moduleId) &&
        moduleId in ['bancos', 'viaticos', 'actividades', 'clara', 'anticipos', 'cxc', 'cxp'] &&
        isValidModuleCompanyDirectory(incoming()) &&
        incoming().moduleId == moduleId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canManageModuleCatalog(moduleId);

      allow update: if isVerifiedUser() &&
        isValidId(moduleId) &&
        moduleId in ['bancos', 'viaticos', 'actividades', 'clara', 'anticipos', 'cxc', 'cxp'] &&
        isValidModuleCompanyDirectory(incoming()) &&
        incoming().moduleId == existing().moduleId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'companies',
          'companiesCount',
          'updatedBy',
          'updatedByName',
          'updatedAt'
        ]) &&
        canManageModuleCatalog(moduleId);

      allow delete: if false;
    }

    match /bank_reconciliations/{bankRecId} {
      // Strictly requires verified Google sign-in and authorization for the Bancos module
      allow get: if isVerifiedUser() &&
        isValidId(bankRecId) &&
        canReadModule('bancos');

      // Verified users can only list their own bank reconciliations
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;

      // Verified admins or active bank operators can create a bank reconciliation
      allow create: if isVerifiedUser() &&
        isValidId(bankRecId) &&
        isValidBankReconciliation(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canOperateModule('bancos');

      // Verified admins or active bank operators can collaboratively update shared bank workspaces
      allow update: if isVerifiedUser() &&
        isValidId(bankRecId) &&
        isValidBankReconciliation(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerName',
          'title',
          'selectedMonth',
          'selectedAccountId',
          'openPeriod',
          'closedReconciliations',
          'societies',
          'accounts',
          'sapOpenItems',
          'sapBalanceRows',
          'statementItems',
          'ledgerItems',
          'matches',
          'accountsCount',
          'statementCount',
          'ledgerCount',
          'updatedAt'
        ]) &&
        (
          isAdmin() ||
          !('closedReconciliations' in existing()) ||
          (
            'closedReconciliations' in incoming() &&
            incoming().closedReconciliations.size() >= existing().closedReconciliations.size()
          )
        ) &&
        (isAdmin() || canOperateModule('bancos'));

      // Only verified admins or active bank owners can delete their bank reconciliation
      allow delete: if isVerifiedUser() &&
        isValidId(bankRecId) &&
        (isAdmin() || (existing().ownerId == request.auth.uid && canOperateModule('bancos')));
    }

    match /user_permissions/{emailDocId} {
      // Strict PII isolation: verified users can read their own permission doc; verified admins (or first-time bootstrapper) can read any
      allow get: if isVerifiedUser() &&
        isValidId(emailDocId) &&
        (emailDocId == myEmailDocId() || isAdmin() || isBootstrapAdmin());

      // Never list user_permissions directly (admins read consolidated registry at /app_settings/access_control)
      allow list: if false;

      // Verified administrators (or first-time bootstrapper prior to access_control creation) can create permission rules
      allow create: if isVerifiedUser() &&
        isValidId(emailDocId) &&
        isValidUserPermission(incoming()) &&
        emailDocId == emailToDocId(incoming().email) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || isBootstrapAdmin());

      // Verified administrators (or first-time bootstrapper) can update permission rules; super-admin cannot be demoted or deactivated
      allow update: if isVerifiedUser() &&
        isValidId(emailDocId) &&
        isValidUserPermission(incoming()) &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        (emailDocId != 'elder_juarez_premexcorp_com' || (incoming().role == 'admin' && incoming().active == true)) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'role',
          'userType',
          'allowedModules',
          'viaticosPanels',
          'companyScope',
          'allowedCompanies',
          'moduleCompanyAccess',
          'active',
          'notes',
          'odooEmployeeName',
          'centroCosto',
          'odooAnalyticDistribution',
          'updatedBy',
          'updatedAt'
        ]) &&
        (isAdmin() || isBootstrapAdmin());

      // Only verified administrators can delete non-super-admin rules
      allow delete: if isVerifiedUser() &&
        isValidId(emailDocId) &&
        emailDocId != 'elder_juarez_premexcorp_com' &&
        isAdmin();
    }

    match /app_settings/{settingId} {
      // Split PII Isolation:
      // - 'policy' contains zero PII (strictMode flag) and can be read by verified signed-in users
      // - 'access_control' contains user emails and is strictly restricted to verified administrators (or first-time bootstrapper)
      allow get: if isVerifiedUser() &&
        isValidId(settingId) &&
        (
          settingId == 'policy' ||
          (settingId == 'access_control' && (isAdmin() || isBootstrapAdmin()))
        );

      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(settingId) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (settingId == 'access_control' && isValidAccessControlRegistry(incoming())) ||
          (settingId == 'policy' && isValidAccessPolicy(incoming()))
        ) &&
        (isAdmin() || isBootstrapAdmin());

      allow update: if isVerifiedUser() &&
        isValidId(settingId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        (
          (
            settingId == 'access_control' &&
            isValidAccessControlRegistry(incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'records',
              'recordsCount',
              'updatedBy',
              'updatedAt'
            ])
          ) ||
          (
            settingId == 'policy' &&
            isValidAccessPolicy(incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'strictMode',
              'updatedBy',
              'updatedAt'
            ])
          )
        ) &&
        (isAdmin() || isBootstrapAdmin());

      allow delete: if false;
    }

    match /viaticos_workspaces/{viaticosId} {
      // Strictly isolated to verified users authorized for Viáticos (protects consultant emails)
      allow get: if isVerifiedUser() &&
        isValidId(viaticosId) &&
        canReadModule('viaticos');

      // Verified users can list only workspaces they created
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;

      // Verified admins or active viaticos operators can create workspaces
      allow create: if isVerifiedUser() &&
        isValidId(viaticosId) &&
        isValidViaticosWorkspace(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canOperateModule('viaticos');

      // Verified admins or active viaticos operators can update allowed workspace fields
      allow update: if isVerifiedUser() &&
        isValidId(viaticosId) &&
        isValidViaticosWorkspace(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerName',
          'title',
          'activeLiquidationId',
          'consultores',
          'liquidaciones',
          'emailGroups',
          'odooCatalogs',
          'consultoresCount',
          'liquidacionesCount',
          'updatedAt'
        ]) &&
        (isAdmin() || canOperateModule('viaticos'));

      // Only verified admins or owners who can operate viaticos can delete
      allow delete: if isVerifiedUser() &&
        isValidId(viaticosId) &&
        (isAdmin() || (existing().ownerId == request.auth.uid && canOperateModule('viaticos')));
    }

    match /viaticos_receipts/{receiptId} {
      // Strictly readable by verified users authorized for Viáticos (all admins, accounting reviewers, and viaticos operators)
      allow get: if isVerifiedUser() &&
        isValidId(receiptId) &&
        canReadModule('viaticos');

      // Clients fetch receipts directly by attachmentId from the workspace; prevent collection listing/scraping
      allow list: if false;

      // Verified admins or active viaticos operators can upload scanned invoice receipts
      allow create: if isVerifiedUser() &&
        isValidId(receiptId) &&
        isValidViaticosReceipt(incoming()) &&
        incoming().id == receiptId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canOperateModule('viaticos');

      // Verified admins or active viaticos operators can update rotated/replaced receipts
      allow update: if isVerifiedUser() &&
        isValidId(receiptId) &&
        isValidViaticosReceipt(incoming()) &&
        incoming().id == existing().id &&
        incoming().parentReceiptId == existing().parentReceiptId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerName',
          'fileName',
          'mimeType',
          'size',
          'chunkIndex',
          'chunkCount',
          'workspaceId',
          'dataUrl',
          'updatedAt'
        ]) &&
        (isAdmin() || canOperateModule('viaticos'));

      // Only verified admins or the creator who can operate viaticos can delete receipt media
      allow delete: if isVerifiedUser() &&
        isValidId(receiptId) &&
        (isAdmin() || (existing().ownerId == request.auth.uid && canOperateModule('viaticos')));
    }

    match /activity_workspaces/{workspaceId} {
      // Strictly isolated to verified users authorized for Panel de Actividades (protects responsible & recipient emails)
      allow get: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        canReadModule('actividades');

      // Verified users can list only workspaces they created
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;

      // Verified admins or active actividades operators can create a workspace
      allow create: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidActivityWorkspace(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canOperateModule('actividades');

      // Verified admins or active actividades operators can collaboratively update allowed workspace fields
      allow update: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidActivityWorkspace(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerName',
          'title',
          'selectedPeriod',
          'societies',
          'responsibles',
          'activities',
          'executions',
          'notificationRecipients',
          'notifyAdminsAutomatically',
          'subtleReminderDaysBefore',
          'societiesCount',
          'activitiesCount',
          'updatedAt'
        ]) &&
        (isAdmin() || canOperateModule('actividades'));

      // Only verified admins or owners who can operate actividades can delete
      allow delete: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        (isAdmin() || (existing().ownerId == request.auth.uid && canOperateModule('actividades')));
    }

    match /clara_workspaces/{claraId} {
      // Strictly isolated to verified users authorized for Gestión TC Clara
      allow get: if isVerifiedUser() &&
        isValidId(claraId) &&
        canReadModule('clara');

      // Verified users can list only workspaces they created
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;

      // Verified admins or active clara operators can create workspaces
      allow create: if isVerifiedUser() &&
        isValidId(claraId) &&
        isValidClaraWorkspace(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canOperateModule('clara');

      // Verified admins or active clara operators can collaboratively update allowed workspace fields
      allow update: if isVerifiedUser() &&
        isValidId(claraId) &&
        isValidClaraWorkspace(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerName',
          'title',
          'selectedPeriod',
          'transactions',
          'workManagerInvoices',
          'vendors',
          'costCenterRules',
          'connectorConfig',
          'batchLogs',
          'transactionsCount',
          'invoicesCount',
          'vendorsCount',
          'updatedAt'
        ]) &&
        (isAdmin() || canOperateModule('clara'));

      // Only verified admins or owners who can operate clara can delete
      allow delete: if isVerifiedUser() &&
        isValidId(claraId) &&
        (isAdmin() || (existing().ownerId == request.auth.uid && canOperateModule('clara')));
    }
  }
}
